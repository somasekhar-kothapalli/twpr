# Copy to .env and fill in. Keep comments on their OWN line: python-dotenv keeps
# an inline "# ..." as the value when the value itself is empty, so
#     EIA_API_KEY=        # free at eia.gov/opendata
# silently sets the key to the comment text and the API answers 403.

# EIA API -- free at https://www.eia.gov/opendata/
# Optional: without it eia_parser.py scrapes instead, and market_data.py
# leaves wti_m1_price / wti_m2_price null.
EIA_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI narrative. MODEL_MODE picks who writes key_drivers/risks/reasoning;
# it never affects grade, direction, confidence or the trade recommendation.
# One of: groq | rule_based | ollama
MODEL_MODE=rule_based
# GROQ_API_KEY -- free at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_URL=http://localhost:11434

# PetroCore backend. Optional -- unset means POSTs are skipped and the JSON
# files in data/ remain the system of record.
PETROCORE_URL=
PETROCORE_API_KEY=

# paper | live -- recorded on the signal and the trade
TWPR_TRADE_TYPE=paper

# Angel One SmartAPI (future -- monitor.py still prompts for the premium)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_TOTP_SECRET=

# How the Z-score noise floor is measured: mad (robust, default) or std (plain std dev)
SIGMA_METHOD=mad

# Lot sizing (signal_engine): account capital in INR; MAX_LOTS caps lots (runbook: 1 for the first 3 weeks)
ACCOUNT_EQUITY_INR=
MAX_LOTS=
